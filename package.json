{
  "name": "shopvento-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "bun test tests/unit",
    "brandcheck": "bun scripts/check-brand.ts",
    "deploy": "bun run build && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false --strict-vars false",
    "test:worker": "bun test tests/worker",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@shopvento/ui": "file:../svui-host-gaps/artifacts/shopvento-ui-0.4.0-8a8aaca860b6.tgz",
    "@tailwindcss/postcss": "4",
    "next": "16",
    "react": "19",
    "react-dom": "19",
    "tailwindcss": "4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
