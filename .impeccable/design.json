  "narrative": {
    "northStar": "Shared time starts with a real upcoming date.",
    "overview": "A warm, light programme for the fictional Nebenan Atelier. Large, conversational headings sit beside useful dates; restrained borders and generous space let the next guest action lead. Shopvento's coral, aubergine and font pairing are binding defaults.",
    "keyCharacteristics": [
      "Open programme rows and clear date hierarchy.",
      "Warm pale surfaces, dark aubergine type and selective coral emphasis.",
      "Quiet controls and rounded containers shared across discovery and commerce."
    ],
    "rules": [
      {
        "name": "The Action Contrast Rule",
        "body": "Coral buttons use aubergine text. Aubergine buttons use the pale on-primary token. Preserve both sides of these pairings when applying runtime branding.",
        "section": "colors"
      },
      {
        "name": "The Shared Scope Rule",
        "body": "The published package owns commerce components and behavior. Extend the host's semantic variables and narrow presentation scopes to keep booking, account, shop and forms in this same visual world.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** keep real dates and the next guest action easy to scan.",
      "**Do** use semantic branding roles across host and package surfaces.",
      "**Do** preserve the light palette, established font pairing and restrained corner hierarchy."
    ],
    "donts": [
      "**Don't** introduce a second visual system inside commerce flows.",
      "**Don't** replace useful programme rows with decorative content or unsupported imagery.",
      "**Don't** remove keyboard focus, validation text or readable action contrast."
    ]
  }
