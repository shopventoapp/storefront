{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopvento-storefront",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "keep_vars": true,
  "vars": { "STOREFRONT_MULTI_TENANT": "false" },
  // Opt-in platform configuration only. No route or secret is added to a
  // single-installation deployment. Provision DNS and secrets separately.
  "env": {
    "platform": {
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "STOREFRONT_MULTI_TENANT": "true" },
      // Platform route placeholder; activate only for the shared deployment.
      // Also provision app.shopvento.app/* with no Worker to bypass this route.
      "routes": [
        { "pattern": "*.shopvento.app/*", "zone_name": "shopvento.app" }
      ],
      // Binding name only, never put the value in this file. The matching
      // backend infrastructure secret must be configured before activation.
      "secrets": { "required": ["STOREFRONT_EDGE_SECRET"] }
    }
  }
}
